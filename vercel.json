{
  "version": 2,
  "builds": [
    {
      "source": "api.py",
      "use": "python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api.py"
    }
  ],
  "env": {
    "FALKORDB_HOST": "localhost",
    "FALKORDB_PORT": "6379",
    "FALKORDB_GRAPH": "graphhacks"
  }
}